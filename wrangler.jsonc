{
  // Cloudflare Worker, der nur die statischen Dateien aus dist/ ausliefert.
  // Deploy: npm run deploy  (braucht CLOUDFLARE_API_TOKEN in der Umgebung – NIE ins Repo schreiben)
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "blickfit",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "visual.auer.page", "custom_domain": true }],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
